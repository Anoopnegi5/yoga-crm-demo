{
  "rewrites": [
    { "source": "/panel", "destination": "/index.html" },
    { "source": "/join", "destination": "/index.html" },
    { "source": "/register", "destination": "/index.html" },
    { "source": "/members", "destination": "/index.html" },
    { "source": "/yogi/:slug", "destination": "/api/yogi-meta" },
    { "source": "/member/:slug", "destination": "/api/yogi-meta" }
  ],
  "headers": [
    {
      "source": "/(panel|members|register|admin)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ]
}
