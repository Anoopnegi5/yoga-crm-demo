{
  "rewrites": [
    { "source": "/panel", "destination": "/index.html" },
    { "source": "/join", "destination": "/index.html" },
    { "source": "/demo", "destination": "/index.html" },
    { "source": "/register", "destination": "/index.html" },
    { "source": "/members", "destination": "/index.html" },
    { "source": "/blog/:slug", "destination": "/api/blog-meta" },
    { "source": "/blog", "destination": "/index.html" },
    { "source": "/yogi/:slug", "destination": "/api/yogi-meta" },
    { "source": "/member/:slug", "destination": "/api/yogi-meta" }
  ],
  "headers": [
    {
      "source": "/(panel|members|register|admin)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(sitemap.xml|robots.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    }
  ]
}
